# Sous V1 — Environment Variables
# Copy to .env.local and fill in values.
#
# For V1 (static data mode), NONE of these are required.
# The app runs fully on static JSON data with mock AI responses.

# ─── Database (optional for V1) ──────────────────────────
# PostgreSQL connection string (Neon serverless recommended)
# Required for: persistent cook sessions, user data, seeding
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ─── AI Providers (optional for V1) ─────────────────────
# Anthropic Claude — craving parsing + coach + AI features
# Required for: AI-powered craving parsing, dish explanations
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — Vision API for food recognition
# Required for: camera-based food identification
# OPENAI_API_KEY=sk-...

# ─── Auth (disabled in V1) ───────────────────────────────
# Clerk authentication — bypassed with mock user in V1
# Required for: production multi-user auth
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# ─── Public URLs ─────────────────────────────────────────
# App URL — used for tRPC client base URL
# Defaults to http://localhost:3000 in development
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Site URL — used for OpenGraph metadata base URL
# Defaults to https://sous.vercel.app
# NEXT_PUBLIC_SITE_URL=https://sous.vercel.app
